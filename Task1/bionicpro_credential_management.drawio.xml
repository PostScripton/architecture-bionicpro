  <diagram name="Credential Management" id="cred-mgmt-1">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Browser / pilot -->
        <mxCell id="person" value="Пилот протеза&#10;[Person]" style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#6C6477;strokeColor=#4D4D4D;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="150" height="130" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="frontend" value="Frontend&#10;[Container: React SPA]&#10;Хранит только сессионную cookie,&#10;токены никогда не попадают в браузер" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- bionicpro-auth BFF -->
        <mxCell id="auth" value="bionicpro-auth&#10;[Container: Go]&#10;BFF: PKCE code exchange, шифрованное&#10;хранение access/refresh токенов,&#10;выпуск HttpOnly+Secure session cookie,&#10;ротация сессии" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="260" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- Session store -->
        <mxCell id="sessions" value="Session Store&#10;[Container: In-memory /&#10;distributed cache]&#10;access/refresh token зашифрованы" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="360" y="460" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Keycloak broker -->
        <mxCell id="keycloak" value="Keycloak&#10;[Container: Identity Broker]&#10;reports-realm: PKCE, OTP MFA,&#10;LDAP federation, Identity Brokering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- Keycloak local DB -->
        <mxCell id="kcdb" value="Keycloak DB&#10;[Container: PostgreSQL]&#10;локальные учётки RU-офиса,&#10;realm/client config" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="700" y="460" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- LDAP foreign office -->
        <mxCell id="ldap" value="LDAP (OpenLDAP)&#10;[Container: представительство&#10;в другой стране]&#10;Персональные и медицинские данные&#10;хранятся локально в стране офиса.&#10;Keycloak читает учётки и роли по сети,&#10;но не копирует персональные данные к себе." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#444444;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="460" width="280" height="140" as="geometry" />
        </mxCell>

        <!-- Yandex ID external IdP -->
        <mxCell id="yandex" value="Yandex ID&#10;[Software System: внешний IdP]&#10;OAuth 2.0 / Identity Brokering.&#10;Профиль пользователя запрашивается&#10;только с согласия пользователя." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="60" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- reports-api -->
        <mxCell id="reportsapi" value="reports-api&#10;[Container: bearer-only]&#10;Проверяет access_token по JWKS,&#10;отдаёт отчёты только своему протезу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="1. GET /auth/login" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="person" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="1/10. GET /auth/login&#10;GET /reports + session cookie" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend" target="auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="2/9. redirect (PKCE challenge)&#10;Set-Cookie: session (HttpOnly, Secure)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3. redirect на Keycloak /auth&#10;(code_challenge, S256)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="keycloak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="6. redirect на /auth/callback?code" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="keycloak" target="auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="7. POST /token&#10;code + code_verifier (без секрета)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="keycloak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. логин + пароль + OTP,&#10;либо кнопка &quot;Войти через Яндекс&quot;" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="keycloak" target="yandex">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. bind + search учёток/ролей" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="keycloak" target="ldap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="локальные RU-учётки" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="keycloak" target="kcdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="8. шифрованные access/refresh" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="sessions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="11. Bearer access_token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="reportsapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend note -->
        <mxCell id="note" value="Унификация доступа: любое представительство BionicPRO подключается к общему Keycloak&#10;через собственный LDAP/внешний IdP. Персональные и медицинские данные не покидают страну.&#10;Токены IdP никогда не передаются фронтенду - только серверная сессионная cookie." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1220" height="70" as="geometry" />
        </mxCell>
      </root>
